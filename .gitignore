# Editors and IDEs
.vscode/
.idea/
.vs/
*.code-workspace

# Local backups, logs and generated artifacts
*.bak
*.log
*.tmp
/artifacts/

# LuaJIT bytecode
*.luac

# Agent tooling state (local only)
# .slim/ holds oh-my-opencode-slim lanes, worktrees and codemap settings.
# codemap.md files are generated from .slim/codemap.json; docs/reference/ARCHITECTURE.md is the tracked reference.
.slim/
**/codemap.md
.claude/settings.local.json

# Local environment files; keep the shareable example template
.env
.env.*
!.env.example

# Operating system metadata
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# BEGIN oh-my-opencode-slim worktrees
.slim/worktrees/
.slim/worktrees.json
# END oh-my-opencode-slim worktrees
